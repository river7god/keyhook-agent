# Copy to .env (git-ignored). Dev values only — never real credentials here.
DATABASE_URL=postgres://keyhook:keyhook@localhost:54329/keyhook
DATABASE_URL_TEST=postgres://keyhook:keyhook@localhost:54329/keyhook_test

# Inngest local dev server (no keys needed in dev mode)
INNGEST_DEV=1

# Claude API (needed for the agent and `pnpm eval`). Never commit a real key.
ANTHROPIC_API_KEY=

# Optional tracing via OTLP (e.g. Langfuse). Leave blank to disable.
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=https://cloud.langfuse.com/api/public/otel/v1/traces
# OTEL_EXPORTER_OTLP_TRACES_HEADERS=Authorization=Basic <base64(publicKey:secretKey)>

# Seeded PM password (dev/demo only) and simulator spend guards
SEED_PM_PASSWORD=keyhook-demo
SIMULATOR_MAX_MESSAGES_PER_HOUR=60
DAILY_LLM_BUDGET_USD=5

# Optional other model providers (organizations.llm_routing selects per step; Claude is default).
# OPENAI_API_KEY=
# DEEPSEEK_API_KEY=          # requires acknowledgeOffshoreProviders in llm_routing
# MOONSHOT_API_KEY=          # Kimi; requires acknowledgeOffshoreProviders
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1   # China endpoint (default: api.moonshot.ai/v1)
# LLM_PRICES_JSON={"deepseek:deepseek-chat":{"input":0.3,"output":1.2,"cacheRead":0.03}}
