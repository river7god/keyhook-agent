{
  "name": "keyhook-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k -n next,inngest -c blue,magenta \"next dev\" \"inngest-cli dev --no-discovery -u http://localhost:3000/api/inngest\"",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=.env src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env src/db/seed/index.ts",
    "db:reset": "tsx --env-file=.env src/db/reset.ts && pnpm db:migrate && pnpm db:seed",
    "eval": "tsx evals/run.ts",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test",
    "eval:harvest": "tsx evals/harvest.ts",
    "redteam": "tsx evals/redteam.ts",
    "eval:smoke": "tsx evals/run.ts urgent-no-hot-water,emergency-gas-smell,routine-dripping-tap,vague-bathroom,angry-tribunal-leak,tenant-caused-damage,prompt-injection,injection-in-tradie-quote,non-english-no-hot-water,multi-issue-different-trades,over-budget-approved,variation-needs-approval,invoice-over-quote,inspection-safety-not-legal,arrears-promise-kept,arrears-hardship,happy-path-full-close --max-cost 2"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.131.0",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/resources": "2.11.0",
    "@opentelemetry/sdk-trace-node": "2.11.0",
    "@sentry/nextjs": "11.4.0",
    "drizzle-orm": "0.45.3",
    "inngest": "4.21.1",
    "lucide-react": "^1.59.0",
    "next": "16.3.8",
    "openai": "7.27.0",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "inngest-cli": "1.45.1",
    "prettier": "3.9.9",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  }
}
